{
  "name": "@neoxr/store",
  "version": "0.0.6",
  "description": "A lightweight, pluggable store for applications that need to retain messages, records, events, contacts, and application state without keeping every item in memory",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "tsc",
    "test": "npx ts-node ./test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoxr/store.git"
  },
  "keywords": [
    "store",
    "message-store",
    "message-cache",
    "whatsap",
    "baileys"
  ],
  "author": "Wildan Izzudin",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/neoxr/store/issues"
  },
  "homepage": "https://github.com/neoxr/store#readme",
  "peerDependencies": {
    "better-sqlite3": "~12.1.1",
    "mongodb": "~4.9.0",
    "mysql2": "~3.12.0",
    "pg": "8.13.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bytes": "^3.1.5",
    "@types/node": "^26.1.0",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.2"
  }
}